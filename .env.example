# Copy this file to .env and fill in real values to connect to a real GrowthBook
# account. Leave .env absent (or these blank) to keep running in demo mode, where
# "Sync to GrowthBook" simulates a realistic response instead of calling out.
#
# .env is never read by the browser and is gitignored — the key only ever lives
# on the server side (server.js), exactly like CF_FRONTEND_API_TOKEN etc. in the
# real CMS's cache-purge routes.

# GrowthBook Personal Access Token or API key with write access to Features.
# Create one at: https://app.growthbook.io/settings/keys
GROWTHBOOK_API_KEY=

# Optional — only needed if your GrowthBook account uses projects and you want
# new features scoped to one specific project instead of the account default.
GROWTHBOOK_PROJECT_ID=

# Required when GROWTHBOOK_API_KEY is a plain API key (not a Personal Access
# Token). GrowthBook attributes every feature it creates to an owner, and API
# keys can't infer one the way a PAT (tied to a logged-in user) can — so you
# must supply the email of the GrowthBook account/member that should own
# features created by this app.
GROWTHBOOK_OWNER_EMAIL=
